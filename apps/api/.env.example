# Smooth Parcel V4 API
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
LOG_LEVEL=debug
DATABASE_URL=postgresql://spv4:spv4@localhost:5433/spv4
TEST_DATABASE_URL=postgresql://spv4:spv4@localhost:5433/spv4_test
# Secrets: generate with `openssl rand -hex 32`
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me
# Where label and document PDFs are written (a persistent volume in production)
DOCUMENTS_DIR=./documents
# Public origins
APP_ORIGIN=http://localhost:5174
API_ORIGIN=http://localhost:3100
TRACK_ORIGIN=http://localhost:3100/track
# Mollie (subscriptions)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=
SUBSCRIPTION_WEEKLY_AMOUNT_GBP=15.00
TRIAL_DAYS=14
# Anthropic (AI features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_BUDGET_GBP=5
# Worker
TRACKING_POLL_CRON=15 */4 * * *
DOCUMENT_RETENTION_DAYS=548
